{
  "name": "ss-dimri",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:drift": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "db:seed": "prisma db seed",
    "db:check": "tsx scripts/db-check.ts",
    "db:studio": "prisma studio",
    "docs:schema": "tsx scripts/generate-schema-docs.ts",
    "storage:check": "tsx scripts/s3-setup.ts",
    "storage:setup": "tsx scripts/s3-setup.ts --create",
    "postinstall": "prisma generate",
    "verify": "npm run db:validate && npm run typecheck && npm run lint && npm run test",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:cleanup": "tsx scripts/e2e-cleanup.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@aws-sdk/s3-request-presigner": "3.1156.0",
    "@neondatabase/serverless": "1.2.0",
    "@prisma/adapter-neon": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.12",
    "clsx": "2.1.1",
    "fflate": "0.8.2",
    "lucide-react": "1.55.0",
    "next": "16.4.2",
    "nodemailer": "10.1.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "24.10.1",
    "@types/nodemailer": "8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=20.19"
  }
}
