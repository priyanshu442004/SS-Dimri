enum ClientReportType {
  MONTHLY_SUMMARY
  AD_HOC
}

enum ClientReportStatus {
  DRAFT
  FINAL
  SHARED
}

enum CommitmentStatus {
  OPEN
  COMPLETED
  CANCELLED
}

/// Client pending dues (13B). Minimal extension point, not an accounting system.
enum DueStatus {
  OPEN
  SETTLED
  WRITTEN_OFF
}

/// Employee vs trainee (appointment letter templates).
enum EmploymentType {
  EMPLOYEE
  TRAINEE
}

/// Attendance hour profile (policy OT-02 / LT-11).
enum AttendanceProfile {
  STANDARD
  ONSITE
  FAR_CLIENT
  REDUCED_HOURS
}

enum SalaryMode {
  TRANSFER
  CASH
}

/// Overtime basis — the two policy versions conflict (see requirements audit).
enum OvertimeMode {
  ACTUAL_MINUTES
  SLABS
}

enum LeaveType {
  CASUAL
  SICK
  PLANNED
  UNPAID
  OTHER
}

enum TimesheetStatus {
  DRAFT
  SUBMITTED
  REVIEWED
