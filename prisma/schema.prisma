  ACCEPTED
  OBSERVATIONS_RAISED
}

enum TaskAttachmentKind {
  IMAGE
  DOCUMENT
  OTHER
}

enum ReminderChannel {
  IN_APP
  EMAIL
  WHATSAPP
}

enum ReminderStatus {
  SCHEDULED
  SENT
  CANCELLED
  FAILED
}

enum TaskActivityType {
  CREATED
  UPDATED
  STATUS_CHANGED
  MAKER_STATUS_CHANGED
  CHECKER_STATUS_CHANGED
  ASSIGNED
  UNASSIGNED
