/// Observations raised by or about a client (13A "client observation"),
/// with responsible person, status and follow-up history (follow_ups).
model ClientObservation {
  id                    String            @id @default(uuid(7)) @db.Uuid
  organizationId        String            @map("organization_id") @db.Uuid
  clientId              String            @map("client_id") @db.Uuid
  taskId                String?           @map("task_id") @db.Uuid
  clientServiceId       String?           @map("client_service_id") @db.Uuid
  responsibleEmployeeId String?           @map("responsible_employee_id") @db.Uuid
  observedOn            DateTime          @map("observed_on") @db.Date
  details               String            @db.Text
  status                ObservationStatus @default(OPEN)
  source                ObservationSource @default(STAFF)
  resolution            String?           @db.Text
  closedAt              DateTime?         @map("closed_at") @db.Timestamptz(3)
  createdById           String?           @map("created_by_id") @db.Uuid
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  client        Client         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  task          Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)
  clientService ClientService? @relation(fields: [clientServiceId], references: [id], onDelete: SetNull)
  responsible   Employee?      @relation("ObservationResponsible", fields: [responsibleEmployeeId], references: [id], onDelete: SetNull)
  createdBy     User?          @relation("ObservationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  followUps     FollowUp[]

