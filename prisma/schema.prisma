}

/// "Type of employment: On-site / Off-site" (Section G).
enum WorkLocationType {
  ON_SITE
  OFF_SITE
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  OTHER
}

enum AddressType {
  CURRENT
  PERMANENT
  OTHER
}

enum SalaryPeriod {
