  name        String
  designation String?
  mobile      String?  @db.VarChar(20)
  email       String?
  address     String?  @db.Text
  isPrimary   Boolean  @default(false) @map("is_primary")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("client_contacts")
}

/// Accounts-outsourcing work types (WT-01 … WT-17) used by timesheets.
model WorkType {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String?
  name           String
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  timesheetEntries TimesheetEntry[]

  @@unique([organizationId, name])
  @@map("work_types")
}

/// Department-wise compliance calendar reference (master data sheet 3).
model ComplianceItem {
  id           String   @id @default(uuid(7)) @db.Uuid
  department   String
  name         String
  form         String?
  applicableTo String?  @map("applicable_to") @db.Text
  frequency    String?
  dueDateRule  String?  @map("due_date_rule") @db.Text
  penalty      String?  @db.Text
  remarks      String?  @db.Text
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([department])
  @@map("compliance_items")
}

/// Leave & Timing Policy parameters, one row per organization. Configurable
/// because the two policy versions conflict; policy_confirmed stays false
/// until the firm confirms, and no payroll outcome is derived meanwhile.
model AttendancePolicy {
  id                          String       @id @default(uuid(7)) @db.Uuid
  organizationId              String       @unique @map("organization_id") @db.Uuid
  officeStart                 String       @default("09:30") @map("office_start") @db.VarChar(5)
  reportingGraceUntil         String       @default("09:45") @map("reporting_grace_until") @db.VarChar(5)
  lunchStart                  String       @default("13:00") @map("lunch_start") @db.VarChar(5)
  lunchEnd                    String       @default("13:30") @map("lunch_end") @db.VarChar(5)
  officeEnd                   String       @default("18:30") @map("office_end") @db.VarChar(5)
  leavingGraceUntil           String       @default("18:45") @map("leaving_grace_until") @db.VarChar(5)
  halfDayIfLeavingBefore      String       @default("17:30") @map("half_day_if_leaving_before") @db.VarChar(5)
  requiredMinutes             Int          @default(540) @map("required_minutes")
  onsiteRequiredMinutes       Int          @default(480) @map("onsite_required_minutes")
  reducedRequiredMinutes      Int          @default(510) @map("reduced_required_minutes")
  farClientEarlyMonthMinutes  Int          @default(510) @map("far_client_early_month_minutes")
  farClientEarlyMonthUntilDay Int          @default(15) @map("far_client_early_month_until_day")
  lateArrivalsPerHalfDay      Int          @default(2) @map("late_arrivals_per_half_day")
  lateGracePerMonth           Int          @default(1) @map("late_grace_per_month")
  overtimeMode                OvertimeMode @default(ACTUAL_MINUTES) @map("overtime_mode")
  overtimeMinutesPerDay       Int          @default(540) @map("overtime_minutes_per_day")
  paidLeavesPerMonth          Decimal      @default(1) @map("paid_leaves_per_month") @db.Decimal(4, 1)
  plannedLeaveNoticeDays      Int          @default(15) @map("planned_leave_notice_days")
  policyConfirmed             Boolean      @default(false) @map("policy_confirmed")
  createdAt                   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("attendance_policies")
}

/// Audited correction of an attendance record (original and new values).
model AttendanceCorrection {
  id                 String   @id @default(uuid(7)) @db.Uuid
  attendanceRecordId String   @map("attendance_record_id") @db.Uuid
  actorUserId        String?  @map("actor_user_id") @db.Uuid
  reason             String   @db.Text
  originalValues     Json     @map("original_values")
  newValues          Json     @map("new_values")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  attendanceRecord AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Restrict)
  actor            User?            @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([attendanceRecordId])
  @@map("attendance_corrections")
}

/// Maker/checker review decisions (history; tasks hold the current status).
model TaskReview {
  id                 String         @id @default(uuid(7)) @db.Uuid
  taskId             String         @map("task_id") @db.Uuid
  reviewerEmployeeId String         @map("reviewer_employee_id") @db.Uuid
  decision           ReviewDecision
  comment            String?        @db.Text
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  task     Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  reviewer Employee @relation(fields: [reviewerEmployeeId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
  @@map("task_reviews")
}

/// Follow-up history for pending items (12A/12B) and client dues (13B).
model FollowUp {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  pendingItemId  String?   @map("pending_item_id") @db.Uuid
  clientDueId    String?   @map("client_due_id") @db.Uuid
  note           String    @db.Text
  nextFollowUpOn DateTime? @map("next_follow_up_on") @db.Date
  actorUserId    String?   @map("actor_user_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pendingItem   PendingItem?       @relation(fields: [pendingItemId], references: [id], onDelete: Cascade)
  clientDue     ClientDue?         @relation(fields: [clientDueId], references: [id], onDelete: Cascade)
  actor         User?              @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  clientVisible Boolean            @default(false) @map("client_visible")
  /// Document supplied with the follow-up (e.g. by the client in reply to a request).
  fileId        String?            @unique @map("file_id") @db.Uuid
  file          StoredFile?        @relation("FollowUpFile", fields: [fileId], references: [id], onDelete: SetNull)
  observationId String?            @map("observation_id") @db.Uuid
  observation   ClientObservation? @relation(fields: [observationId], references: [id], onDelete: Cascade)

  @@index([observationId])
  @@index([pendingItemId])
  @@index([clientDueId])
  @@map("follow_ups")
}

/// In-app notifications.
model Notification {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  type           String
  title          String
  body           String?   @db.Text
  link           String?
  readAt         DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

