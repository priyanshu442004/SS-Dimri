/// Nature of business master (NB-01 … NB-29). Client has primary + secondary.
model BusinessNature {
  id          String   @id @default(uuid(7)) @db.Uuid
  code        String   @unique
  label       String
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  primaryClients   Client[] @relation("ClientPrimaryNature")
  secondaryClients Client[] @relation("ClientSecondaryNature")

  @@map("business_natures")
}

/// Client classification masters (bases B–G of the master data pack).
model ClassificationOption {
  id          String              @id @default(uuid(7)) @db.Uuid
  basis       ClassificationBasis
  code        String              @unique
  label       String
  description String?
  sortOrder   Int                 @default(0) @map("sort_order")
  isActive    Boolean             @default(true) @map("is_active")
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  clientClassifications ClientClassification[]

  @@index([basis])
  @@map("classification_options")
}

/// One classification tag per basis per client.
model ClientClassification {
  id        String              @id @default(uuid(7)) @db.Uuid
  clientId  String              @map("client_id") @db.Uuid
  basis     ClassificationBasis
  optionId  String              @map("option_id") @db.Uuid
