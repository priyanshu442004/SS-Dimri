  RETURNED
}

enum ReviewDecision {
  APPROVED
  CHANGES_REQUESTED
}

/// Client classification bases B–G from the ERP master data pack.
enum ClassificationBasis {
  GST_STATUS
  BILLING_BASIS
  PLACE_OF_WORK
  TURNOVER
  PRIORITY
}

/// How a client record was created.
enum ClientRegistrationChannel {
  STAFF
  CLIENT_QUICK
  CLIENT_FULL
}

/// How "days pending" is counted. Not confirmed by the firm — configurable.
enum PendingDaysBasis {
  CALENDAR
  /// Monday–Saturday (the firm's working week); Sundays are not counted.
  BUSINESS
}

/// Client observation lifecycle. PROVISIONAL — no statuses given in the sources.
enum ObservationStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ObservationSource {
  CLIENT
  STAFF
}

// =============================================================================
// AUTHENTICATION (Better Auth core tables — kept separate from business data)
// Passwords are hashed by Better Auth and stored in accounts.password.
// =============================================================================

model User {
  id              String   @id @default(uuid(7)) @db.Uuid
  name            String
  email           String   @unique
  emailVerified   Boolean  @default(false) @map("email_verified")
  image           String?
  /// Login ID created by the admin (Better Auth username plugin).
  username        String?  @unique
  displayUsername String?  @map("display_username")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions    Session[]
  accounts    Account[]
  memberships OrganizationMembership[]

  approvedClients       Client[]               @relation("ClientApprovedBy")
  rejectedClients       Client[]               @relation("ClientRejectedBy")
  createdClients        Client[]               @relation("ClientCreatedBy")
  approvedEmployees     Employee[]             @relation("EmployeeApprovedBy")
  rejectedEmployees     Employee[]             @relation("EmployeeRejectedBy")
  uploadedFiles         StoredFile[]
  auditLogs             AuditLog[]
  createdAllocations    TeamAllocation[]
  createdTasks          Task[]                 @relation("TaskCreatedBy")
  taskActivities        TaskActivity[]
  createdReminders      TaskReminder[]
  assignedTasks         TaskAssignment[]       @relation("TaskAssignedBy")
  decidedLeaveRequests  LeaveRequest[]         @relation("LeaveDecidedBy")
  recordedAttendance    AttendanceRecord[]     @relation("AttendanceRecordedBy")
  createdPendingItems   PendingItem[]
  generatedClientReport ClientReport[]
  createdSalaryRecords  EmployeeSalaryRecord[]
  createdDues           ClientDue[]
  notifications         Notification[]
  attendanceCorrections AttendanceCorrection[]
  followUps             FollowUp[]
  reviewedTimesheets    TimesheetEntry[]       @relation("TimesheetReviewedBy")
  createdObservations   ClientObservation[]    @relation("ObservationCreatedBy")

  @@map("users")
}

model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  /// Hashed by Better Auth (scrypt). Never plaintext.
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}

// =============================================================================
// GLOBAL MASTER / LOOKUP DATA
// =============================================================================

/// "Nature of User" dropdown (Sections A, C, E). Options PENDING CONFIRMATION,
/// so this is a configurable table rather than an enum. Not seeded.
model NatureOfUserOption {
  id        String   @id @default(uuid(7)) @db.Uuid
  code      String   @unique
  label     String
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organizations Organization[]
  clients       Client[]
  services      Service[]

  @@map("nature_of_user_options")
}

/// Constitution master (Section D). Seeded with the five confirmed types in the
/// initial migration. Representatives live in constitution_members.
model Constitution {
  id                 String                 @id @default(uuid(7)) @db.Uuid
  type               ConstitutionType       @unique
  /// Master data code (CON-01 … CON-11).
  code               String?                @unique
  name               String
  /// Role label used for this constitution's representatives
  /// (Proprietor / Partner / Director / Trustee / Karta).
  representativeRole ConstitutionMemberRole @map("representative_role")
  /// Descriptive only (not enforced): firms/companies/trusts typically have several.
  allowsMultiple     Boolean                @default(true) @map("allows_multiple")
  sortOrder          Int                    @default(0) @map("sort_order")
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  organizations Organization[]
  clients       Client[]

  @@map("constitutions")
}

// =============================================================================
// ORGANIZATION (Section A, B)
// =============================================================================

model Organization {
  id                    String                @id @default(uuid(7)) @db.Uuid
  tradeName             String                @map("trade_name")
  legalName             String?               @map("legal_name")
  address               String?               @db.Text
  tan                   String?               @db.VarChar(10)
  pan                   String?               @db.VarChar(10)
  gstin                 String?               @db.VarChar(15)
  gstVerificationStatus GstVerificationStatus @default(NOT_VERIFIED) @map("gst_verification_status")
  gstVerifiedAt         DateTime?             @map("gst_verified_at") @db.Timestamptz(3)
  natureOfUserId        String?               @map("nature_of_user_id") @db.Uuid
  constitutionId        String?               @map("constitution_id") @db.Uuid
  profilePictureFileId  String?               @unique @map("profile_picture_file_id") @db.Uuid

  // Contact details (manually entered)
  contactPersonName String? @map("contact_person_name")
  contactMobile     String? @map("contact_mobile") @db.VarChar(20)
  contactEmail      String? @map("contact_email")
  contactPhone      String? @map("contact_phone") @db.VarChar(20)

  accessMode            OrganizationAccessMode @default(SINGLE_USER) @map("access_mode")
  /// Sub-users / licenses: maximum number of active memberships.
  licensedUserLimit     Int                    @default(1) @map("licensed_user_limit")
  /// Number of employees / clients DECLARED at registration (actual counts are derived).
  declaredEmployeeCount Int?                   @map("declared_employee_count")
  declaredClientCount   Int?                   @map("declared_client_count")
  /// Default probation ("7 days") for new employees — configurable, not hardcoded.
  defaultProbationDays  Int                    @default(7) @map("default_probation_days")
  timezone              String                 @default("Asia/Kolkata")
  status                OrganizationStatus     @default(ACTIVE)
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  natureOfUser   NatureOfUserOption? @relation(fields: [natureOfUserId], references: [id], onDelete: SetNull)
  constitution   Constitution?       @relation(fields: [constitutionId], references: [id], onDelete: Restrict)
  profilePicture StoredFile?         @relation("OrganizationProfilePicture", fields: [profilePictureFileId], references: [id], onDelete: SetNull)

  certificate         OrganizationCertificate?
  memberships         OrganizationMembership[]
  documents           OrganizationDocument[]
  previousCompanies   OrganizationPreviousCompany[]
  files               StoredFile[]                  @relation("OrganizationFiles")
  auditLogs           AuditLog[]
  constitutionMembers ConstitutionMember[]
  clients             Client[]
  departments         Department[]
  services            Service[]
  clientServices      ClientService[]
  designations        Designation[]
  employeeNatures     EmployeeNatureOption[]
  employees           Employee[]
  teamAllocations     TeamAllocation[]
  tasks               Task[]
  attendanceRecords   AttendanceRecord[]
  leaveBalances       LeaveBalance[]
  leaveRequests       LeaveRequest[]
  timesheetEntries    TimesheetEntry[]
  pendingItems        PendingItem[]
  dayReports          DayReport[]
  workCommitments     WorkCommitment[]
  clientReports       ClientReport[]
  clientDues          ClientDue[]
  purchaseOrders      ClientPurchaseOrder[]
  attendancePolicy    AttendancePolicy?
  workTypes           WorkType[]
  notifications       Notification[]
  followUps           FollowUp[]
  pendingDaysBasis    PendingDaysBasis              @default(CALENDAR) @map("pending_days_basis")
  /// Days a pending staff member or client may use their account before approval (0 = no access until approved).
  approvalGraceDays   Int                           @default(7) @map("approval_grace_days")
  observations        ClientObservation[]
  emails              EmailOutbox[]

  @@index([pan])
  @@index([gstin])
  @@map("organizations")
}

/// Exactly ONE certificate per organization (Section B, confirmed) —
/// enforced by the unique organization_id.
model OrganizationCertificate {
  id                String    @id @default(uuid(7)) @db.Uuid
  organizationId    String    @unique @map("organization_id") @db.Uuid
  certificateName   String?   @map("certificate_name")
  certificateNumber String?   @map("certificate_number")
  issuedOn          DateTime? @map("issued_on") @db.Date
  expiresOn         DateTime? @map("expires_on") @db.Date
  fileId            String    @unique @map("file_id") @db.Uuid
  notes             String?   @db.Text
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  file         StoredFile   @relation("OrganizationCertificateFile", fields: [fileId], references: [id], onDelete: Restrict)

  @@map("organization_certificates")
}

/// Links an authenticated user to an organization (multi-user / sub-users).
model OrganizationMembership {
  id                    String           @id @default(uuid(7)) @db.Uuid
  organizationId        String           @map("organization_id") @db.Uuid
  userId                String           @map("user_id") @db.Uuid
  /// Optional link to the staff record this login belongs to.
  employeeId            String?          @unique @map("employee_id") @db.Uuid
  role                  MembershipRole   @default(STAFF)
  status                MembershipStatus @default(ACTIVE)
  /// Set when an admin issues an initial password; cleared once the user changes it.
  mustChangePassword    Boolean          @default(false) @map("must_change_password")
  /// Emailed temporary password stops working after this time (admin can resend the invitation).
  tempPasswordExpiresAt DateTime?        @map("temp_password_expires_at") @db.Timestamptz(3)
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  employee     Employee?    @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  /// For role CLIENT: the client this login belongs to.
  clientId     String?      @map("client_id") @db.Uuid
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([clientId])
  @@index([userId])
  @@map("organization_memberships")
}

/// Organization-level documents, e.g. Leave Policy (Section A).
model OrganizationDocument {
  id             String                   @id @default(uuid(7)) @db.Uuid
  organizationId String                   @map("organization_id") @db.Uuid
  type           OrganizationDocumentType
  title          String?
  fileId         String                   @unique @map("file_id") @db.Uuid
  effectiveFrom  DateTime?                @map("effective_from") @db.Date
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  file         StoredFile   @relation("OrganizationDocumentFile", fields: [fileId], references: [id], onDelete: Restrict)

  @@index([organizationId, type])
  @@map("organization_documents")
}

/// "Previous Company Details" of the registering organization (Section A).
/// Interpretation documented in docs/assumptions-and-open-questions.md.
model OrganizationPreviousCompany {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  companyName    String    @map("company_name")
  address        String?   @db.Text
  fromDate       DateTime? @map("from_date") @db.Date
  toDate         DateTime? @map("to_date") @db.Date
  details        String?   @db.Text
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("organization_previous_companies")
}

// =============================================================================
// FILES & AUDIT
// =============================================================================

/// Metadata + private S3 reference for every uploaded file. Binary content is
/// never stored in PostgreSQL. Access is via short-lived pre-signed URLs only.
model StoredFile {
  id               String              @id @default(uuid(7)) @db.Uuid
  organizationId   String?             @map("organization_id") @db.Uuid
  provider         FileStorageProvider @default(S3)
  bucket           String
  /// Full object key, always under the project prefix (S3_KEY_PREFIX).
  objectKey        String              @unique @map("object_key")
  originalFileName String              @map("original_file_name")
  mimeType         String              @map("mime_type")
  sizeBytes        BigInt              @map("size_bytes")
  checksumSha256   String?             @map("checksum_sha256") @db.VarChar(64)
  uploadedById     String?             @map("uploaded_by_id") @db.Uuid
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Set when the object has been removed from storage.
  deletedAt        DateTime?           @map("deleted_at") @db.Timestamptz(3)

  organization Organization? @relation("OrganizationFiles", fields: [organizationId], references: [id], onDelete: Restrict)
  uploadedBy   User?         @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  // Back-relations (each file is used by at most one owner slot)
  organizationProfilePicture Organization?               @relation("OrganizationProfilePicture")
  organizationCertificate    OrganizationCertificate?    @relation("OrganizationCertificateFile")
  organizationDocument       OrganizationDocument?       @relation("OrganizationDocumentFile")
  constitutionMemberPicture  ConstitutionMember?         @relation("ConstitutionMemberPicture")
  clientProfilePicture       Client?                     @relation("ClientProfilePicture")
  clientMsmeCertificate      Client?                     @relation("ClientMsmeCertificate")
  clientEsiCertificate       Client?                     @relation("ClientEsiCertificate")
  clientPfCertificate        Client?                     @relation("ClientPfCertificate")
  clientDocument             ClientDocument?             @relation("ClientDocumentFile")
  clientPurchaseOrder        ClientPurchaseOrder?        @relation("ClientPurchaseOrderFile")
  employeeProfilePicture     Employee?                   @relation("EmployeeProfilePicture")
  employeeAadhaarDocument    Employee?                   @relation("EmployeeAadhaarDocument")
  employeePanDocument        Employee?                   @relation("EmployeePanDocument")
  employeeDocument           EmployeeDocument?           @relation("EmployeeDocumentFile")
  employeeBankBook           EmployeeBankAccount?        @relation("EmployeeBankBook")
  employeeQualification      EmployeeQualification?      @relation("EmployeeQualificationCertificate")
  employeeExperience         EmployeePreviousEmployment? @relation("EmployeeExperienceCertificate")
  employeeMemo               EmployeeMemo?               @relation("EmployeeMemoFile")
  taskAttachment             TaskAttachment?             @relation("TaskAttachmentFile")
  attendanceTimeInPhoto      AttendanceRecord?           @relation("AttendanceTimeInPhoto")
  attendanceTimeOutPhoto     AttendanceRecord?           @relation("AttendanceTimeOutPhoto")
  clientReportExport         ClientReport?               @relation("ClientReportFile")
  followUp                   FollowUp?                   @relation("FollowUpFile")

  @@index([organizationId])
  @@map("stored_files")
}

/// Audit trail for approvals and sensitive changes. Never store secrets or
/// raw PAN/Aadhaar/bank numbers in `metadata`.
model AuditLog {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id") @db.Uuid
  metadata       Json?
  ipAddress      String?  @map("ip_address")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor        User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// =============================================================================
// CLIENTS (Section C, D, GST)
// =============================================================================

model Client {
  id                   String                  @id @default(uuid(7)) @db.Uuid
  organizationId       String                  @map("organization_id") @db.Uuid
  /// Human-readable client ID (optional, unique per organization).
  clientCode           String?                 @map("client_code")
  tradeName            String                  @map("trade_name")
  legalName            String?                 @map("legal_name")
  address              String?                 @db.Text
  tan                  String?                 @db.VarChar(10)
  pan                  String?                 @db.VarChar(10)
  natureOfUserId       String?                 @map("nature_of_user_id") @db.Uuid
  /// One Time / Retainer. Scope PENDING CONFIRMATION — see also client_services.engagement_nature.
  natureOfClient       ClientEngagementNature? @map("nature_of_client")
  constitutionId       String?                 @map("constitution_id") @db.Uuid
  profilePictureFileId String?                 @unique @map("profile_picture_file_id") @db.Uuid

  // MSME / ESI / PF
  isMsme                 Boolean? @map("is_msme")
  msmeRegistrationNumber String?  @map("msme_registration_number")
  msmeCertificateFileId  String?  @unique @map("msme_certificate_file_id") @db.Uuid
  esiNumber              String?  @map("esi_number")
  esiCertificateFileId   String?  @unique @map("esi_certificate_file_id") @db.Uuid
  pfNumber               String?  @map("pf_number")
  pfCertificateFileId    String?  @unique @map("pf_certificate_file_id") @db.Uuid

  // Registration lifecycle (quick registration -> PENDING_APPROVAL -> ACTIVE)
  status             ClientStatus @default(PENDING_APPROVAL)
  createdById        String?      @map("created_by_id") @db.Uuid
  submittedAt        DateTime?    @map("submitted_at") @db.Timestamptz(3)
  approvedAt         DateTime?    @map("approved_at") @db.Timestamptz(3)
  approvedById       String?      @map("approved_by_id") @db.Uuid
  rejectedAt         DateTime?    @map("rejected_at") @db.Timestamptz(3)
  rejectedById       String?      @map("rejected_by_id") @db.Uuid
  rejectionReason    String?      @map("rejection_reason") @db.Text
  /// Set when the remaining (optional) details are filled in after quick registration.
  detailsCompletedAt DateTime?    @map("details_completed_at") @db.Timestamptz(3)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  natureOfUser    NatureOfUserOption? @relation(fields: [natureOfUserId], references: [id], onDelete: SetNull)
  constitution    Constitution?       @relation(fields: [constitutionId], references: [id], onDelete: Restrict)
  profilePicture  StoredFile?         @relation("ClientProfilePicture", fields: [profilePictureFileId], references: [id], onDelete: SetNull)
  msmeCertificate StoredFile?         @relation("ClientMsmeCertificate", fields: [msmeCertificateFileId], references: [id], onDelete: SetNull)
  esiCertificate  StoredFile?         @relation("ClientEsiCertificate", fields: [esiCertificateFileId], references: [id], onDelete: SetNull)
  pfCertificate   StoredFile?         @relation("ClientPfCertificate", fields: [pfCertificateFileId], references: [id], onDelete: SetNull)
  createdBy       User?               @relation("ClientCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy      User?               @relation("ClientApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  rejectedBy      User?               @relation("ClientRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)

  gstRegistrations          ClientGstRegistration[]
  constitutionMembers       ConstitutionMember[]
  documents                 ClientDocument[]
  purchaseOrders            ClientPurchaseOrder[]
  services                  ClientService[]
  teamAllocations           TeamAllocation[]
  tasks                     Task[]
  timesheetEntries          TimesheetEntry[]
  pendingItems              PendingItem[]
  workCommitments           WorkCommitment[]
  reports                   ClientReport[]
  dues                      ClientDue[]
  primaryBusinessNatureId   String?                   @map("primary_business_nature_id") @db.Uuid
  secondaryBusinessNatureId String?                   @map("secondary_business_nature_id") @db.Uuid
  primaryBusinessNature     BusinessNature?           @relation("ClientPrimaryNature", fields: [primaryBusinessNatureId], references: [id], onDelete: SetNull)
  secondaryBusinessNature   BusinessNature?           @relation("ClientSecondaryNature", fields: [secondaryBusinessNatureId], references: [id], onDelete: SetNull)
  contacts                  ClientContact[]
  classifications           ClientClassification[]
  registrationChannel       ClientRegistrationChannel @default(STAFF) @map("registration_channel")
  portalMemberships         OrganizationMembership[]
  observations              ClientObservation[]

  @@unique([organizationId, clientCode])
  @@index([organizationId, status])
  @@index([organizationId, tradeName])
  @@index([pan])
  @@map("clients")
}

/// One client -> many GSTINs (confirmed). Deliberately minimal for now:
/// no state/address/certificate/verification columns.
model ClientGstRegistration {
  id        String   @id @default(uuid(7)) @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  gstin     String   @db.VarChar(15)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, gstin])
  @@index([gstin])
  @@map("client_gst_registrations")
}

/// Representatives under a constitution: proprietor, partners, directors,
/// trustees, karta (Section D). client_id NULL = representative of the
/// organization itself; otherwise of that client.
model ConstitutionMember {
  id                   String                 @id @default(uuid(7)) @db.Uuid
  organizationId       String                 @map("organization_id") @db.Uuid
  clientId             String?                @map("client_id") @db.Uuid
  role                 ConstitutionMemberRole
  fullName             String                 @map("full_name")
  mobile               String?                @db.VarChar(20)
  email                String?
  address              String?                @db.Text
  pan                  String?                @db.VarChar(10)
  /// AES-256-GCM ciphertext. Never select into broad APIs.
  aadhaarEncrypted     String?                @map("aadhaar_encrypted")
  aadhaarLast4         String?                @map("aadhaar_last4") @db.Char(4)
  profilePictureFileId String?                @unique @map("profile_picture_file_id") @db.Uuid
  isPrimary            Boolean                @default(false) @map("is_primary")
  sortOrder            Int                    @default(0) @map("sort_order")
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  profilePicture StoredFile?  @relation("ConstitutionMemberPicture", fields: [profilePictureFileId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([clientId])
  @@map("constitution_members")
}

/// Client "Certificates" (multiple allowed) and other client documents.
model ClientDocument {
  id        String             @id @default(uuid(7)) @db.Uuid
  clientId  String             @map("client_id") @db.Uuid
  type      ClientDocumentType
  title     String?
  fileId    String             @unique @map("file_id") @db.Uuid
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  client Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  file   StoredFile @relation("ClientDocumentFile", fields: [fileId], references: [id], onDelete: Restrict)

  @@index([clientId, type])
  @@map("client_documents")
}

/// "PO Detail" (Section C). A client may issue several purchase orders.
model ClientPurchaseOrder {
  id              String    @id @default(uuid(7)) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  clientId        String    @map("client_id") @db.Uuid
  clientServiceId String?   @map("client_service_id") @db.Uuid
  poNumber        String    @map("po_number")
  poDate          DateTime? @map("po_date") @db.Date
  amount          Decimal?  @db.Decimal(14, 2)
  validFrom       DateTime? @map("valid_from") @db.Date
  validTo         DateTime? @map("valid_to") @db.Date
  details         String?   @db.Text
  fileId          String?   @unique @map("file_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientService ClientService? @relation(fields: [clientServiceId], references: [id], onDelete: SetNull)
  file          StoredFile?    @relation("ClientPurchaseOrderFile", fields: [fileId], references: [id], onDelete: SetNull)

  @@unique([clientId, poNumber])
  @@index([organizationId])
  @@map("client_purchase_orders")
}

// =============================================================================
// SERVICES (Section E — Services Offered master; Section F — Services List)
// =============================================================================

model Department {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  description    String?  @db.Text
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  services     Service[]
  /// Master data code (DEP-01 …).
  code         String?
  scope        String?      @db.Text
  /// false = "Suggested" in the master data pack, pending confirmation.
  isConfirmed  Boolean      @default(true) @map("is_confirmed")
  employees    Employee[]

  @@unique([organizationId, name])
  @@map("departments")
}

/// Service master: "Nature of Services Offered" (Section E).
model Service {
  id                    String   @id @default(uuid(7)) @db.Uuid
  organizationId        String   @map("organization_id") @db.Uuid
  /// Human-readable Service ID.
  serviceCode           String?  @map("service_code")
  departmentId          String?  @map("department_id") @db.Uuid
  name                  String
  description           String?  @db.Text
  /// Standard fee; the agreed fee per client lives on client_services.
  defaultFee            Decimal? @map("default_fee") @db.Decimal(14, 2)
  natureOfUserId        String?  @map("nature_of_user_id") @db.Uuid
  /// Timeline / estimated duration.
  estimatedDurationDays Int?     @map("estimated_duration_days")
  timelineNote          String?  @map("timeline_note") @db.Text

  // Default point of contact (internal employee and/or free-text details)
  pocEmployeeId String? @map("poc_employee_id") @db.Uuid
  pocName       String? @map("poc_name")
  pocMobile     String? @map("poc_mobile") @db.VarChar(20)
  pocEmail      String? @map("poc_email")
  pocAddress    String? @map("poc_address") @db.Text

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department   Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  natureOfUser NatureOfUserOption? @relation(fields: [natureOfUserId], references: [id], onDelete: SetNull)
  pocEmployee  Employee?           @relation("ServicePoc", fields: [pocEmployeeId], references: [id], onDelete: SetNull)

  clientServices ClientService[]
  frequency      String?
  deliverable    String?         @db.Text
  billingBasis   String?         @map("billing_basis")
  /// false = "Suggested" in the master data pack, pending confirmation.
  isConfirmed    Boolean         @default(true) @map("is_confirmed")

  @@unique([organizationId, serviceCode])
  @@unique([organizationId, name])
  @@index([departmentId])
  @@map("services")
}

/// "Services List" (Section F): a service engaged by a specific client, with
/// its own description, timeline, POC and agreed fee. Client <-> Service M:N.
model ClientService {
  id                String                  @id @default(uuid(7)) @db.Uuid
  organizationId    String                  @map("organization_id") @db.Uuid
  clientId          String                  @map("client_id") @db.Uuid
  serviceId         String                  @map("service_id") @db.Uuid
  description       String?                 @db.Text
  agreedFee         Decimal?                @map("agreed_fee") @db.Decimal(14, 2)
  /// One Time / Retainer per engagement — scope PENDING CONFIRMATION.
  engagementNature  ClientEngagementNature? @map("engagement_nature")
  startDate         DateTime?               @map("start_date") @db.Date
  dueDate           DateTime?               @map("due_date") @db.Date
  timelineNote      String?                 @map("timeline_note") @db.Text
  /// Retainer validity window. The "one-month expiry" rule is NOT enforced yet.
  retainerStartDate DateTime?               @map("retainer_start_date") @db.Date
  retainerEndDate   DateTime?               @map("retainer_end_date") @db.Date
  /// Previous engagement this one renews (retainer renewal chain).
  renewedFromId     String?                 @unique @map("renewed_from_id") @db.Uuid
  status            ClientServiceStatus     @default(ACTIVE)

  pocEmployeeId String? @map("poc_employee_id") @db.Uuid
  pocName       String? @map("poc_name")
  pocMobile     String? @map("poc_mobile") @db.VarChar(20)
  pocEmail      String? @map("poc_email")
  pocAddress    String? @map("poc_address") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  client       Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service      Service        @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  pocEmployee  Employee?      @relation("ClientServicePoc", fields: [pocEmployeeId], references: [id], onDelete: SetNull)
  renewedFrom  ClientService? @relation("ClientServiceRenewal", fields: [renewedFromId], references: [id], onDelete: SetNull)
  renewedBy    ClientService? @relation("ClientServiceRenewal")

  purchaseOrders   ClientPurchaseOrder[]
  teamAllocations  TeamAllocation[]
  tasks            Task[]
  timesheetEntries TimesheetEntry[]
  workCommitments  WorkCommitment[]
  dues             ClientDue[]
  observations     ClientObservation[]

  @@index([organizationId])
  @@index([clientId, status])
  @@index([serviceId])
  @@map("client_services")
}

// =============================================================================
// EMPLOYEES (Section G)
// =============================================================================

/// Configurable designations (Manager, Senior, Executive, Account Trainee,
/// Associate Partner — defaults, not exhaustive).
model Designation {
  id             String          @id @default(uuid(7)) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  name           String
  /// Optional mapping to Junior / Mid-level / Senior (Section H).
  seniorityLevel SeniorityLevel? @map("seniority_level")
  sortOrder      Int             @default(0) @map("sort_order")
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees    Employee[]

  @@unique([organizationId, name])
  @@map("designations")
}

/// Configurable "Nature of Employee" (Frontend/Extended?, Backend, On-site —
/// wording uncertain, see open questions).
model EmployeeNatureOption {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  label          String
  /// Original handwritten wording, preserved for review.
  sourceWording  String?  @map("source_wording")
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees    Employee[]

  @@unique([organizationId, label])
  @@map("employee_nature_options")
}

model Employee {
  id             String @id @default(uuid(7)) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  // Temporary -> permanent identifier workflow
  temporaryEmployeeCode String         @map("temporary_employee_code")
  permanentEmployeeCode String?        @map("permanent_employee_code")
  idType                EmployeeIdType @default(TEMPORARY) @map("id_type")
  permanentIdAssignedAt DateTime?      @map("permanent_id_assigned_at") @db.Timestamptz(3)

  approvalStatus EmployeeApprovalStatus @default(PENDING) @map("approval_status")
  approvedAt     DateTime?              @map("approved_at") @db.Timestamptz(3)
  approvedById   String?                @map("approved_by_id") @db.Uuid
  rejectedAt     DateTime?              @map("rejected_at") @db.Timestamptz(3)
  rejectedById   String?                @map("rejected_by_id") @db.Uuid
  reviewNotes    String?                @map("review_notes") @db.Text

  employmentStatus   EmploymentStatus @default(PROBATION) @map("employment_status")
  dateOfJoining      DateTime?        @map("date_of_joining") @db.Date
  /// Probation / trial window ("7 days"); defaults from organizations.default_probation_days.
  probationStartDate DateTime?        @map("probation_start_date") @db.Date
  probationEndDate   DateTime?        @map("probation_end_date") @db.Date
  exitDate           DateTime?        @map("exit_date") @db.Date

  // Personal
  firstName     String         @map("first_name")
  lastName      String?        @map("last_name")
  gender        Gender?
  /// Age is DERIVED from date_of_birth.
  dateOfBirth   DateTime?      @map("date_of_birth") @db.Date
  maritalStatus MaritalStatus? @map("marital_status")

  // Identity (sensitive)
  aadhaarEncrypted      String? @map("aadhaar_encrypted")
  aadhaarLast4          String? @map("aadhaar_last4") @db.Char(4)
  aadhaarDocumentFileId String? @unique @map("aadhaar_document_file_id") @db.Uuid
  panNumber             String? @map("pan_number") @db.VarChar(10)
  panDocumentFileId     String? @unique @map("pan_document_file_id") @db.Uuid

  // Role
  designationId    String?           @map("designation_id") @db.Uuid
  natureId         String?           @map("nature_id") @db.Uuid
  workLocationType WorkLocationType? @map("work_location_type")

  // Contact
  mobile        String? @db.VarChar(20)
  email         String?
  /// Official email / email app.
  officialEmail String? @map("official_email")

  profilePictureFileId String?  @unique @map("profile_picture_file_id") @db.Uuid
  /// "Message / remarks".
  remarks              String?  @db.Text
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  designation     Designation?          @relation(fields: [designationId], references: [id], onDelete: SetNull)
  nature          EmployeeNatureOption? @relation(fields: [natureId], references: [id], onDelete: SetNull)
  approvedBy      User?                 @relation("EmployeeApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  rejectedBy      User?                 @relation("EmployeeRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)
  profilePicture  StoredFile?           @relation("EmployeeProfilePicture", fields: [profilePictureFileId], references: [id], onDelete: SetNull)
  aadhaarDocument StoredFile?           @relation("EmployeeAadhaarDocument", fields: [aadhaarDocumentFileId], references: [id], onDelete: SetNull)
  panDocument     StoredFile?           @relation("EmployeePanDocument", fields: [panDocumentFileId], references: [id], onDelete: SetNull)

  membership OrganizationMembership?

  // Owned profile records (cascade when a rejected temporary record is deleted)
  addresses           EmployeeAddress[]
  bankAccounts        EmployeeBankAccount[]
  qualifications      EmployeeQualification[]
  personalReferences  EmployeeReference[]
  previousEmployments EmployeePreviousEmployment[]
  documents           EmployeeDocument[]
  salaryRecords       EmployeeSalaryRecord[]
  memos               EmployeeMemo[]               @relation("MemoEmployee")
  issuedMemos         EmployeeMemo[]               @relation("MemoIssuedBy")

  // "Whom to Report" — multi-select, self-referential M:N
  reportsTo EmployeeReportingRelationship[] @relation("ReportingEmployee")
  reportees EmployeeReportingRelationship[] @relation("ReportingManager")

  // Operational records (RESTRICT: an employee with history cannot be hard-deleted)
  servicePocs              Service[]            @relation("ServicePoc")
  clientServicePocs        ClientService[]      @relation("ClientServicePoc")
  teamAllocations          TeamAllocation[]
  makerTasks               Task[]               @relation("TaskMaker")
  checkerTasks             Task[]               @relation("TaskChecker")
  writingFromTasks         Task[]               @relation("TaskWritingFrom")
  taskAssignments          TaskAssignment[]     @relation("TaskAssignee")
  taskReminders            TaskReminder[]
  attendanceRecords        AttendanceRecord[]
  leaveBalances            LeaveBalance[]
  leaveRequests            LeaveRequest[]
  timesheetEntries         TimesheetEntry[]
  pendingWithItems         PendingItem[]        @relation("PendingWithEmployee")
  raisedPendingItems       PendingItem[]        @relation("PendingRaisedBy")
  dayReports               DayReport[]
  dayReportRecipients      DayReportRecipient[]
  workCommitments          WorkCommitment[]
  departmentId             String?              @map("department_id") @db.Uuid
  department               Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  employmentType           EmploymentType       @default(EMPLOYEE) @map("employment_type")
  attendanceProfile        AttendanceProfile    @default(STANDARD) @map("attendance_profile")
  fatherName               String?              @map("father_name")
  motherName               String?              @map("mother_name")
  voterIdNumber            String?              @map("voter_id_number")
  uanNumber                String?              @map("uan_number")
  esiIpNumber              String?              @map("esi_ip_number")
  emergencyContactName     String?              @map("emergency_contact_name")
  emergencyContactRelation String?              @map("emergency_contact_relation")
  emergencyContactPhone    String?              @map("emergency_contact_phone") @db.VarChar(20)
  offerAcceptedOn          DateTime?            @map("offer_accepted_on") @db.Date
  /// Set when the employee submits onboarding details for admin approval.
  onboardingSubmittedAt    DateTime?            @map("onboarding_submitted_at") @db.Timestamptz(3)
  taskReviews              TaskReview[]
  responsibleObservations  ClientObservation[]  @relation("ObservationResponsible")

  @@unique([organizationId, temporaryEmployeeCode])
  @@unique([organizationId, permanentEmployeeCode])
  @@index([organizationId, approvalStatus])
  @@index([organizationId, employmentStatus])
  @@index([designationId])
  @@map("employees")
}

/// "Whom to Report" (multi-select). employee -> manager, many-to-many.
model EmployeeReportingRelationship {
  id         String    @id @default(uuid(7)) @db.Uuid
  employeeId String    @map("employee_id") @db.Uuid
  managerId  String    @map("manager_id") @db.Uuid
  isPrimary  Boolean   @default(false) @map("is_primary")
  startDate  DateTime? @map("start_date") @db.Date
  endDate    DateTime? @map("end_date") @db.Date
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  employee Employee @relation("ReportingEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  manager  Employee @relation("ReportingManager", fields: [managerId], references: [id], onDelete: Cascade)

  @@unique([employeeId, managerId])
  @@index([managerId])
  @@map("employee_reporting_relationships")
}

/// Current / permanent / other addresses (one or more).
model EmployeeAddress {
  id         String      @id @default(uuid(7)) @db.Uuid
  employeeId String      @map("employee_id") @db.Uuid
  type       AddressType
  line1      String
  line2      String?
  city       String?
  state      String?
  pincode    String?     @db.VarChar(10)
  country    String      @default("India")
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, type])
  @@map("employee_addresses")
}

/// Bank account details. "Bank Account Code" interpreted as account number.
model EmployeeBankAccount {
  id                     String   @id @default(uuid(7)) @db.Uuid
  employeeId             String   @map("employee_id") @db.Uuid
  accountHolderName      String?  @map("account_holder_name")
  /// AES-256-GCM ciphertext.
  accountNumberEncrypted String   @map("account_number_encrypted")
  accountNumberLast4     String   @map("account_number_last4") @db.VarChar(4)
  ifscCode               String   @map("ifsc_code") @db.VarChar(11)
  bankName               String?  @map("bank_name")
  branch                 String?
  /// Bank book upload — crossed out in notes; OPTIONAL until confirmed.
  bankBookFileId         String?  @unique @map("bank_book_file_id") @db.Uuid
  isPrimary              Boolean  @default(true) @map("is_primary")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  employee Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  bankBook StoredFile? @relation("EmployeeBankBook", fields: [bankBookFileId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@map("employee_bank_accounts")
}

/// Qualification + certificate upload.
model EmployeeQualification {
  id                String   @id @default(uuid(7)) @db.Uuid
  employeeId        String   @map("employee_id") @db.Uuid
  qualification     String
  institution       String?
  yearOfPassing     Int?     @map("year_of_passing")
  certificateFileId String?  @unique @map("certificate_file_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  employee    Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  certificate StoredFile? @relation("EmployeeQualificationCertificate", fields: [certificateFileId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@map("employee_qualifications")
}

/// "Reference of the Reference" — wording unclear; see open questions.
model EmployeeReference {
  id           String   @id @default(uuid(7)) @db.Uuid
  employeeId   String   @map("employee_id") @db.Uuid
  name         String
  relationship String?
  mobile       String?  @db.VarChar(20)
  email        String?
  address      String?  @db.Text
  /// Who referred / vouched for this reference ("reference of the reference").
  referredBy   String?  @map("referred_by")
  notes        String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_references")
}

/// Details of previous employer + experience certificate (Section A continuation).
model EmployeePreviousEmployment {
  id                          String    @id @default(uuid(7)) @db.Uuid
  employeeId                  String    @map("employee_id") @db.Uuid
  employerName                String    @map("employer_name")
  employerAddress             String?   @map("employer_address") @db.Text
  designation                 String?
  contactNumber               String?   @map("contact_number") @db.VarChar(20)
  fromDate                    DateTime? @map("from_date") @db.Date
  toDate                      DateTime? @map("to_date") @db.Date
  experienceCertificateFileId String?   @unique @map("experience_certificate_file_id") @db.Uuid
  createdAt                   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  employee              Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  experienceCertificate StoredFile? @relation("EmployeeExperienceCertificate", fields: [experienceCertificateFileId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@map("employee_previous_employments")
}

/// Joining letter, offer letter and other employment documents.
model EmployeeDocument {
  id         String               @id @default(uuid(7)) @db.Uuid
  employeeId String               @map("employee_id") @db.Uuid
  type       EmployeeDocumentType
  title      String?
  issuedOn   DateTime?            @map("issued_on") @db.Date
  fileId     String               @unique @map("file_id") @db.Uuid
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  employee Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  file     StoredFile @relation("EmployeeDocumentFile", fields: [fileId], references: [id], onDelete: Restrict)

  @@index([employeeId, type])
  @@map("employee_documents")
}

/// Agreed salary and committed increments, as dated history.
model EmployeeSalaryRecord {
  id                        String       @id @default(uuid(7)) @db.Uuid
  employeeId                String       @map("employee_id") @db.Uuid
  effectiveFrom             DateTime     @map("effective_from") @db.Date
  agreedSalary              Decimal      @map("agreed_salary") @db.Decimal(14, 2)
  salaryPeriod              SalaryPeriod @default(MONTHLY) @map("salary_period")
  committedIncrementAmount  Decimal?     @map("committed_increment_amount") @db.Decimal(14, 2)
  committedIncrementPercent Decimal?     @map("committed_increment_percent") @db.Decimal(5, 2)
  committedIncrementDate    DateTime?    @map("committed_increment_date") @db.Date
  /// "Increment amount / continuation details" — exact wording pending.
  incrementNotes            String?      @map("increment_notes") @db.Text
  createdById               String?      @map("created_by_id") @db.Uuid
  createdAt                 DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdBy  User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  salaryMode SalaryMode? @map("salary_mode")

  @@index([employeeId, effectiveFrom])
  @@map("employee_salary_records")
}

/// Disciplinary memos (e.g. misconduct).
model EmployeeMemo {
  id                 String       @id @default(uuid(7)) @db.Uuid
  employeeId         String       @map("employee_id") @db.Uuid
  memoDate           DateTime     @map("memo_date") @db.Date
  category           MemoCategory @default(OTHER)
  subject            String
  description        String?      @db.Text
  issuedByEmployeeId String?      @map("issued_by_employee_id") @db.Uuid
  fileId             String?      @unique @map("file_id") @db.Uuid
  acknowledgedAt     DateTime?    @map("acknowledged_at") @db.Timestamptz(3)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  employee       Employee    @relation("MemoEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  issuedBy       Employee?   @relation("MemoIssuedBy", fields: [issuedByEmployeeId], references: [id], onDelete: SetNull)
  file           StoredFile? @relation("EmployeeMemoFile", fields: [fileId], references: [id], onDelete: SetNull)
  memoNumber     String?     @map("memo_number")
  actionRequired String?     @map("action_required") @db.Text
  replyByDate    DateTime?   @map("reply_by_date") @db.Date

  @@index([employeeId, memoDate])
  @@map("employee_memos")
}

// =============================================================================
// TEAM ALLOCATION (Section H)
// =============================================================================

/// One row per employee allocated to a client (optionally a specific service).
/// Changes of allocation end the old row and create a new one that points
/// back via replaces_allocation_id, preserving history.
model TeamAllocation {
  id                   String           @id @default(uuid(7)) @db.Uuid
  organizationId       String           @map("organization_id") @db.Uuid
  clientId             String           @map("client_id") @db.Uuid
  clientServiceId      String?          @map("client_service_id") @db.Uuid
  employeeId           String           @map("employee_id") @db.Uuid
  /// Junior / Mid-level / Senior role on this allocation.
  seniorityLevel       SeniorityLevel?  @map("seniority_level")
  startDate            DateTime         @map("start_date") @db.Date
  endDate              DateTime?        @map("end_date") @db.Date
  /// Optional share of the employee's capacity (0-100) for availability views.
  allocationPercent    Int?             @map("allocation_percent")
  status               AllocationStatus @default(ACTIVE)
  replacesAllocationId String?          @unique @map("replaces_allocation_id") @db.Uuid
  changeReason         String?          @map("change_reason") @db.Text
  createdById          String?          @map("created_by_id") @db.Uuid
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  client             Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  clientService      ClientService?  @relation(fields: [clientServiceId], references: [id], onDelete: SetNull)
  employee           Employee        @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  replacesAllocation TeamAllocation? @relation("AllocationChange", fields: [replacesAllocationId], references: [id], onDelete: SetNull)
  replacedBy         TeamAllocation? @relation("AllocationChange")
  createdBy          User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)

  timesheetEntries TimesheetEntry[]

  @@index([organizationId, status])
  @@index([clientId, status])
  @@index([employeeId, startDate, endDate])
  @@map("team_allocations")
}

// =============================================================================
// TASK MANAGEMENT (Section I)
// =============================================================================

model Task {
  id              String       @id @default(uuid(7)) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  clientId        String?      @map("client_id") @db.Uuid
  clientServiceId String?      @map("client_service_id") @db.Uuid
  title           String
  /// Quick task: text / written work. Images & documents are task_attachments.
  description     String?      @db.Text
  priority        TaskPriority @default(MEDIUM)
  isAsap          Boolean      @default(false) @map("is_asap")
  /// Timeline. Overdue = due_at < now() AND status NOT IN (COMPLETED, CANCELLED) — derived.
  startAt         DateTime?    @map("start_at") @db.Timestamptz(3)
  dueAt           DateTime?    @map("due_at") @db.Timestamptz(3)
  status          TaskStatus   @default(PENDING)
  completedAt     DateTime?    @map("completed_at") @db.Timestamptz(3)

  /// "Writing for — client side / remark".
  writingForRemark      String? @map("writing_for_remark") @db.Text
  /// "Writing from — team member / remark".
  writingFromEmployeeId String? @map("writing_from_employee_id") @db.Uuid
  writingFromRemark     String? @map("writing_from_remark") @db.Text

  // Maker / checker
  makerEmployeeId   String?       @map("maker_employee_id") @db.Uuid
  makerStatus       MakerStatus   @default(NOT_STARTED) @map("maker_status")
  makerUpdatedAt    DateTime?     @map("maker_updated_at") @db.Timestamptz(3)
  checkerEmployeeId String?       @map("checker_employee_id") @db.Uuid
  checkerStatus     CheckerStatus @default(NOT_STARTED) @map("checker_status")
  checkerUpdatedAt  DateTime?     @map("checker_updated_at") @db.Timestamptz(3)

  // Client observation (13A)
  clientObservationStatus ClientObservationStatus @default(NOT_SHARED) @map("client_observation_status")
  clientObservationNote   String?                 @map("client_observation_note") @db.Text

  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  client        Client?        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  clientService ClientService? @relation(fields: [clientServiceId], references: [id], onDelete: SetNull)
  writingFrom   Employee?      @relation("TaskWritingFrom", fields: [writingFromEmployeeId], references: [id], onDelete: SetNull)
  maker         Employee?      @relation("TaskMaker", fields: [makerEmployeeId], references: [id], onDelete: Restrict)
  checker       Employee?      @relation("TaskChecker", fields: [checkerEmployeeId], references: [id], onDelete: Restrict)
  createdBy     User?          @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  assignments       TaskAssignment[]
  attachments       TaskAttachment[]
  reminders         TaskReminder[]
  activities        TaskActivity[]
  reviews           TaskReview[]
  timesheetEntries  TimesheetEntry[]
  pendingItems      PendingItem[]
  /// Shown in the client portal (title, status, due date and client-visible remarks only).
  clientVisible     Boolean             @default(false) @map("client_visible")
  /// Set when the overdue notification has been sent (avoids repeats).
  overdueNotifiedAt DateTime?           @map("overdue_notified_at") @db.Timestamptz(3)
  observations      ClientObservation[]

  @@index([organizationId, status, dueAt])
  @@index([clientId, status])
  @@index([makerEmployeeId])
  @@index([checkerEmployeeId])
  @@map("tasks")
}

/// Multiple assignees per task. removed_at marks an ended assignment.
model TaskAssignment {
  id           String    @id @default(uuid(7)) @db.Uuid
  taskId       String    @map("task_id") @db.Uuid
  employeeId   String    @map("employee_id") @db.Uuid
  assignedById String?   @map("assigned_by_id") @db.Uuid
  assignedAt   DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(3)
  removedAt    DateTime? @map("removed_at") @db.Timestamptz(3)

  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employee   Employee @relation("TaskAssignee", fields: [employeeId], references: [id], onDelete: Restrict)
  assignedBy User?    @relation("TaskAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([taskId, employeeId])
  @@index([employeeId])
  @@map("task_assignments")
}

/// "Attached artifact" — images and documents for quick task creation.
model TaskAttachment {
  id        String             @id @default(uuid(7)) @db.Uuid
  taskId    String             @map("task_id") @db.Uuid
  fileId    String             @unique @map("file_id") @db.Uuid
  kind      TaskAttachmentKind
  caption   String?
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  task Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  file StoredFile @relation("TaskAttachmentFile", fields: [fileId], references: [id], onDelete: Restrict)

  @@index([taskId])
  @@map("task_attachments")
}

/// "Reminder option / timings".
model TaskReminder {
  id                  String          @id @default(uuid(7)) @db.Uuid
  taskId              String          @map("task_id") @db.Uuid
  recipientEmployeeId String?         @map("recipient_employee_id") @db.Uuid
  remindAt            DateTime        @map("remind_at") @db.Timestamptz(3)
  channel             ReminderChannel @default(IN_APP)
  status              ReminderStatus  @default(SCHEDULED)
  sentAt              DateTime?       @map("sent_at") @db.Timestamptz(3)
  note                String?
  createdById         String?         @map("created_by_id") @db.Uuid
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  recipient Employee? @relation(fields: [recipientEmployeeId], references: [id], onDelete: SetNull)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status, remindAt])
  @@index([taskId])
  @@map("task_reminders")
}

/// Append-only history of task status, maker/checker and assignment changes.
model TaskActivity {
  id          String           @id @default(uuid(7)) @db.Uuid
  taskId      String           @map("task_id") @db.Uuid
  actorUserId String?          @map("actor_user_id") @db.Uuid
  type        TaskActivityType
  fromValue   String?          @map("from_value")
  toValue     String?          @map("to_value")
  note        String?          @db.Text
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  task          Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor         User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  /// Remark visible to the client. Internal remarks are never shown in the portal.
  clientVisible Boolean @default(false) @map("client_visible")

  @@index([taskId, createdAt])
  @@map("task_activities")
}

// =============================================================================
// ATTENDANCE & LEAVE (Section J)
// =============================================================================

/// Work hours are DERIVED from time_out - time_in.
/// No unique (employee, date): multiple sessions per day are not yet ruled out.
model AttendanceRecord {
  id                 String           @id @default(uuid(7)) @db.Uuid
  organizationId     String           @map("organization_id") @db.Uuid
  employeeId         String           @map("employee_id") @db.Uuid
  attendanceDate     DateTime         @map("attendance_date") @db.Date
  timeIn             DateTime?        @map("time_in") @db.Timestamptz(3)
  timeOut            DateTime?        @map("time_out") @db.Timestamptz(3)
  timeInLatitude     Decimal?         @map("time_in_latitude") @db.Decimal(9, 6)
  timeInLongitude    Decimal?         @map("time_in_longitude") @db.Decimal(9, 6)
  timeOutLatitude    Decimal?         @map("time_out_latitude") @db.Decimal(9, 6)
  timeOutLongitude   Decimal?         @map("time_out_longitude") @db.Decimal(9, 6)
  /// Live picture captured at time-in / time-out.
  timeInPhotoFileId  String?          @unique @map("time_in_photo_file_id") @db.Uuid
  timeOutPhotoFileId String?          @unique @map("time_out_photo_file_id") @db.Uuid
  status             AttendanceStatus
  remarks            String?          @db.Text
  recordedById       String?          @map("recorded_by_id") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee     Employee               @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  timeInPhoto  StoredFile?            @relation("AttendanceTimeInPhoto", fields: [timeInPhotoFileId], references: [id], onDelete: SetNull)
  timeOutPhoto StoredFile?            @relation("AttendanceTimeOutPhoto", fields: [timeOutPhotoFileId], references: [id], onDelete: SetNull)
  recordedBy   User?                  @relation("AttendanceRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  /// Reason recorded for a late arrival (policy LT-05 grace).
  lateReason   String?                @map("late_reason") @db.Text
  corrections  AttendanceCorrection[]

  /// One record per employee per day (corrections update it; see attendance_corrections).
  @@unique([employeeId, attendanceDate])
  @@index([organizationId, attendanceDate])
  @@map("attendance_records")
}

/// "Allowed paid leaves" per employee per leave year. Used leave is derived
/// from approved leave_requests / attendance.
model LeaveBalance {
  id                String   @id @default(uuid(7)) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  employeeId        String   @map("employee_id") @db.Uuid
  periodStart       DateTime @map("period_start") @db.Date
  periodEnd         DateTime @map("period_end") @db.Date
  allowedPaidLeaves Decimal  @map("allowed_paid_leaves") @db.Decimal(5, 1)
  notes             String?  @db.Text
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, periodStart])
  @@index([organizationId])
  @@map("leave_balances")
}

model LeaveRequest {
  id             String             @id @default(uuid(7)) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  employeeId     String             @map("employee_id") @db.Uuid
  fromDate       DateTime           @map("from_date") @db.Date
  toDate         DateTime           @map("to_date") @db.Date
  isHalfDay      Boolean            @default(false) @map("is_half_day")
  isPaid         Boolean            @default(true) @map("is_paid")
  reason         String?            @db.Text
  status         LeaveRequestStatus @default(PENDING)
  decidedById    String?            @map("decided_by_id") @db.Uuid
  decidedAt      DateTime?          @map("decided_at") @db.Timestamptz(3)
  decisionNote   String?            @map("decision_note") @db.Text
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  decidedBy      User?        @relation("LeaveDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  leaveType      LeaveType    @default(CASUAL) @map("leave_type")
  /// Leave without intimation is treated differently by policy LV-03.
  withIntimation Boolean      @default(true) @map("with_intimation")

  @@index([organizationId, status])
  @@index([employeeId, fromDate])
  @@map("leave_requests")
}

// =============================================================================
// TIMESHEET (10A daily entries) & PENDING TRACKER (10B / 12A / 12B)
// =============================================================================

model TimesheetEntry {
  id               String      @id @default(uuid(7)) @db.Uuid
  organizationId   String      @map("organization_id") @db.Uuid
  employeeId       String      @map("employee_id") @db.Uuid
  /// Serial number as entered on the sheet.
  serialNumber     Int?        @map("serial_number")
  /// Date of visit / work date.
  workDate         DateTime    @map("work_date") @db.Date
  clientId         String?     @map("client_id") @db.Uuid
  /// Free-text client name when the client is not (yet) registered.
  clientNameText   String?     @map("client_name_text")
  clientServiceId  String?     @map("client_service_id") @db.Uuid
  taskId           String?     @map("task_id") @db.Uuid
  teamAllocationId String?     @map("team_allocation_id") @db.Uuid
  placeOfWork      String?     @map("place_of_work")
  typeOfWork       String?     @map("type_of_work")
  /// Bank name — for bank/card work.
  bankName         String?     @map("bank_name")
  periodFrom       DateTime?   @map("period_from") @db.Date
  periodTo         DateTime?   @map("period_to") @db.Date
  /// Number of transactions / entries.
  transactionCount Int?        @map("transaction_count")
  /// Approximate time taken, in minutes.
  approxMinutes    Int?        @map("approx_minutes")
  /// "Message through WhatsApp".
  whatsappMessage  String?     @map("whatsapp_message") @db.Text
  /// 10B: details & status of work done.
  workDetails      String?     @map("work_details") @db.Text
  workStatus       WorkStatus? @map("work_status")
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee       Employee        @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  client         Client?         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  clientService  ClientService?  @relation(fields: [clientServiceId], references: [id], onDelete: SetNull)
  task           Task?           @relation(fields: [taskId], references: [id], onDelete: SetNull)
  teamAllocation TeamAllocation? @relation(fields: [teamAllocationId], references: [id], onDelete: SetNull)

  pendingItems PendingItem[]
  workTypeId   String?         @map("work_type_id") @db.Uuid
  workType     WorkType?       @relation(fields: [workTypeId], references: [id], onDelete: SetNull)
  status       TimesheetStatus @default(SUBMITTED)
  reviewedById String?         @map("reviewed_by_id") @db.Uuid
  reviewedBy   User?           @relation("TimesheetReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?       @map("reviewed_at") @db.Timestamptz(3)
  reviewNote   String?         @map("review_note") @db.Text

  @@index([organizationId, workDate])
  @@index([employeeId, workDate])
  @@index([clientId, workDate])
  @@index([taskId])
  @@map("timesheet_entries")
}

/// Unified pending-work / follow-up record (10B), surfaced as
/// 12A Daily (category DAILY) and 12B Communication (category COMMUNICATION).
/// pending_with distinguishes client-side vs team-side pending work.
/// Days pending is DERIVED: (closed_at or today) - requested_on.
model PendingItem {
  id                    String          @id @default(uuid(7)) @db.Uuid
  organizationId        String          @map("organization_id") @db.Uuid
  category              PendingCategory
  pendingWith           PendingWith     @map("pending_with")
  clientId              String?         @map("client_id") @db.Uuid
  taskId                String?         @map("task_id") @db.Uuid
  timesheetEntryId      String?         @map("timesheet_entry_id") @db.Uuid
  /// Team member the item is pending with (when pending_with = TEAM_MEMBER).
  pendingWithEmployeeId String?         @map("pending_with_employee_id") @db.Uuid
  raisedByEmployeeId    String?         @map("raised_by_employee_id") @db.Uuid
  /// "What we asked" / "What client asked us — still needs to be done".
  requestDescription    String          @map("request_description") @db.Text
  /// "Asked / request given on".
  requestedOn           DateTime        @map("requested_on") @db.Date
  /// "Due by — date promised".
  dueBy                 DateTime?       @map("due_by") @db.Date
  status                PendingStatus   @default(OPEN)
  closedAt              DateTime?       @map("closed_at") @db.Timestamptz(3)
  /// Remark ("Discomfort Remark"? — wording unclear).
  remark                String?         @db.Text
  createdById           String?         @map("created_by_id") @db.Uuid
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization        Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  client              Client?         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  task                Task?           @relation(fields: [taskId], references: [id], onDelete: SetNull)
  timesheetEntry      TimesheetEntry? @relation(fields: [timesheetEntryId], references: [id], onDelete: SetNull)
  pendingWithEmployee Employee?       @relation("PendingWithEmployee", fields: [pendingWithEmployeeId], references: [id], onDelete: Restrict)
  raisedByEmployee    Employee?       @relation("PendingRaisedBy", fields: [raisedByEmployeeId], references: [id], onDelete: SetNull)
  createdBy           User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  followUps           FollowUp[]
  /// Request shown to the client in the portal.
  clientVisible       Boolean         @default(false) @map("client_visible")

  @@index([organizationId, category, status])
  @@index([organizationId, pendingWith, status])
  @@index([clientId, status])
  @@index([pendingWithEmployeeId, status])
  @@map("pending_items")
}

// =============================================================================
// REPORTS (11 Day report; 13A Client report; 13B Client pending dues)
// =============================================================================

/// Day report (11): reporting person -> manager(s).
model DayReport {
  id                  String          @id @default(uuid(7)) @db.Uuid
  organizationId      String          @map("organization_id") @db.Uuid
  reportingEmployeeId String          @map("reporting_employee_id") @db.Uuid
  reportDate          DateTime        @map("report_date") @db.Date
  summary             String?         @db.Text
  status              DayReportStatus @default(DRAFT)
  submittedAt         DateTime?       @map("submitted_at") @db.Timestamptz(3)
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  reportingEmployee Employee             @relation(fields: [reportingEmployeeId], references: [id], onDelete: Restrict)
  recipients        DayReportRecipient[]
  workPlan          String?              @map("work_plan") @db.Text
  completedWork     String?              @map("completed_work") @db.Text
  newAssignments    String?              @map("new_assignments") @db.Text
  pendingWork       String?              @map("pending_work") @db.Text
  blockers          String?              @db.Text

  @@index([organizationId, reportDate])
  @@index([reportingEmployeeId, reportDate])
  @@map("day_reports")
}

/// "Send to the Manager" — supports several managers (reporting is multi-select).
model DayReportRecipient {
  id                  String    @id @default(uuid(7)) @db.Uuid
  dayReportId         String    @map("day_report_id") @db.Uuid
  recipientEmployeeId String    @map("recipient_employee_id") @db.Uuid
  sentAt              DateTime? @map("sent_at") @db.Timestamptz(3)
  readAt              DateTime? @map("read_at") @db.Timestamptz(3)
  acknowledgedAt      DateTime? @map("acknowledged_at") @db.Timestamptz(3)

  dayReport    DayReport @relation(fields: [dayReportId], references: [id], onDelete: Cascade)
  recipient    Employee  @relation(fields: [recipientEmployeeId], references: [id], onDelete: Restrict)
  /// Manager's review remark on the day report.
  reviewRemark String?   @map("review_remark") @db.Text

  @@unique([dayReportId, recipientEmployeeId])
  @@index([recipientEmployeeId])
  @@map("day_report_recipients")
}

/// "Team-wise committed work" (13A): what each team member committed to
/// deliver for a client over a period.
model WorkCommitment {
  id              String           @id @default(uuid(7)) @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  clientId        String           @map("client_id") @db.Uuid
  clientServiceId String?          @map("client_service_id") @db.Uuid
  employeeId      String           @map("employee_id") @db.Uuid
  periodStart     DateTime         @map("period_start") @db.Date
  periodEnd       DateTime         @map("period_end") @db.Date
  description     String           @db.Text
  targetDate      DateTime?        @map("target_date") @db.Date
  status          CommitmentStatus @default(OPEN)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientService ClientService? @relation(fields: [clientServiceId], references: [id], onDelete: SetNull)
  employee      Employee       @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([clientId, periodStart])
  @@index([employeeId, periodStart])
  @@index([organizationId])
  @@map("work_commitments")
}

/// Client report (13A). Live data is derived from source tables; `snapshot`
/// freezes the report contents at generation time for historical accuracy.
model ClientReport {
  id              String             @id @default(uuid(7)) @db.Uuid
  organizationId  String             @map("organization_id") @db.Uuid
  clientId        String             @map("client_id") @db.Uuid
  reportType      ClientReportType   @default(MONTHLY_SUMMARY) @map("report_type")
  periodStart     DateTime           @map("period_start") @db.Date
  periodEnd       DateTime           @map("period_end") @db.Date
  status          ClientReportStatus @default(DRAFT)
  /// "End-of-month summary / details" (wording unclear).
  summaryNotes    String?            @map("summary_notes") @db.Text
  /// Frozen JSON of team list, maker/checker status, observations, pending
  /// (our side / client side), fees, team involvement, committed work.
  snapshot        Json?
  snapshotVersion Int                @default(1) @map("snapshot_version")
  exportFileId    String?            @unique @map("export_file_id") @db.Uuid
  generatedById   String?            @map("generated_by_id") @db.Uuid
  generatedAt     DateTime?          @map("generated_at") @db.Timestamptz(3)
  sharedAt        DateTime?          @map("shared_at") @db.Timestamptz(3)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  exportFile   StoredFile?  @relation("ClientReportFile", fields: [exportFileId], references: [id], onDelete: SetNull)
  generatedBy  User?        @relation(fields: [generatedById], references: [id], onDelete: SetNull)

  @@index([clientId, periodStart])
  @@index([organizationId, periodStart])
  @@map("client_reports")
}

/// Client pending dues (13B). Extension point until the fee/invoice/payment
/// workflow is clarified — NOT a full accounting ledger.
model ClientDue {
  id              String    @id @default(uuid(7)) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  clientId        String    @map("client_id") @db.Uuid
  clientServiceId String?   @map("client_service_id") @db.Uuid
  description     String
  referenceNumber String?   @map("reference_number")
  amount          Decimal   @db.Decimal(14, 2)
  dueDate         DateTime? @map("due_date") @db.Date
  status          DueStatus @default(OPEN)
  settledAt       DateTime? @map("settled_at") @db.Timestamptz(3)
  notes           String?   @db.Text
  createdById     String?   @map("created_by_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  client        Client         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  clientService ClientService? @relation(fields: [clientServiceId], references: [id], onDelete: SetNull)
  createdBy     User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  followUps     FollowUp[]

  @@index([clientId, status])
  @@index([organizationId, status, dueDate])
  @@map("client_dues")
}

