// =============================================================================
// SS Dimri — database schema (Prisma 7, PostgreSQL on Neon)
//
// Conventions
// - Models are PascalCase, fields camelCase; tables/columns map to snake_case.
// - Primary keys are UUIDv7 (time-ordered) generated by Prisma Client.
// - Timestamps are `timestamptz` stored in UTC. Business calendar dates
//   (attendance date, work date, due dates) are `date` columns interpreted in
//   the organization's timezone (organizations.timezone, default Asia/Kolkata).
// - Money is Decimal(14,2). Coordinates are Decimal(9,6).
// - Uploaded files live in private S3; the DB stores only references in
//   `stored_files` (see docs/database-design.md).
// - Aadhaar and bank account numbers are stored AES-256-GCM encrypted
//   (src/lib/security/encryption.ts) with a last-4 column for display.
// - Tenant scoping: every top-level business row carries organization_id.
//   Child rows (addresses, GSTINs, ...) are scoped through their parent.
//
// Requirement traceability: docs/requirements-traceability.md
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// ENUMS
// =============================================================================

/// Organization registration: single-user vs multi-user access (Section A).
enum OrganizationAccessMode {
  SINGLE_USER
  MULTI_USER
}

/// Not specified by the client; ACTIVE is the only state used for now.
enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

/// Application roles inside an organization. PROVISIONAL — exact roles pending.
enum MembershipRole {
  OWNER
  ADMIN
  MANAGER
  STAFF
  /// Senior: reviews and creates work for their team (DFD).
  SENIOR
  /// Business client with portal access to its own records only.
  CLIENT
}

enum MembershipStatus {
  INVITED
  ACTIVE
  DISABLED
}

/// Constitution master list (Section D) — confirmed five types.
enum ConstitutionType {
  PROPRIETOR
  FIRM
  COMPANY
  TRUST
  HUF
  INDIVIDUAL
  LLP
  PUBLIC_COMPANY
  OPC
  AOP_BOI
  GOVERNMENT
}

/// Role a representative holds under a constitution (Section D).
enum ConstitutionMemberRole {
  PROPRIETOR
  PARTNER
  DIRECTOR
  TRUSTEE
  KARTA
  OTHER
  MEMBER
}

/// Client quick registration -> admin approval -> active (Section C, confirmed).
/// INACTIVE is for a previously approved client that is no longer serviced.
enum ClientStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  INACTIVE
  /// Master data pack STS-02 "On Hold".
  ON_HOLD
}

/// Nature of Client (Section C). Scope (client vs engagement) PENDING CONFIRMATION.
enum ClientEngagementNature {
  ONE_TIME
  RETAINER
}

enum ClientServiceStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum GstVerificationStatus {
  NOT_VERIFIED
  VERIFIED
  FAILED
}

enum FileStorageProvider {
  S3
}

enum OrganizationDocumentType {
  LEAVE_POLICY
  OTHER
}

enum ClientDocumentType {
  REGISTRATION_CERTIFICATE
  OTHER
}

enum EmployeeDocumentType {
  JOINING_LETTER
  OFFER_LETTER
  EXPERIENCE_CERTIFICATE
  OTHER
  PHOTOGRAPH
  ADDRESS_PROOF
  MARKSHEET_10
  MARKSHEET_12
  DEGREE
  PROFESSIONAL_CERTIFICATE
  RELIEVING_LETTER
  SALARY_SLIP
  APPOINTMENT_LETTER
  POLICY_ACKNOWLEDGEMENT
  JOINING_FORM
  CANCELLED_CHEQUE
