# Copy to .env.local and fill in real values. Never commit real credentials.

# Neon pooled connection string (host contains "-pooler") — used by the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require"
# Neon direct connection string (same host WITHOUT "-pooler") — used by Prisma CLI for migrations
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Better Auth — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET="replace-with-32-byte-random-base64"
BETTER_AUTH_URL="http://localhost:3000"

# AES-256-GCM key, base64-encoded 32 bytes (same command as above). Losing it makes encrypted fields unreadable.
DATA_ENCRYPTION_KEY="replace-with-32-byte-random-base64"

# Private document storage: DigitalOcean Spaces (S3-compatible API; the AWS_* names are kept).
# For Spaces set AWS_REGION to the Spaces region (e.g. blr1) and S3_ENDPOINT to https://<region>.digitaloceanspaces.com.
# Leave S3_ENDPOINT empty to use AWS S3.
AWS_ACCESS_KEY_ID="replace-me"
AWS_SECRET_ACCESS_KEY="replace-me"
AWS_REGION="ap-south-1"
AWS_BUCKET_NAME="replace-me"
S3_ENDPOINT=""
S3_KEY_PREFIX="ss-dimri"

# Optional: per-IP sign-in attempts per minute (default 5). Raise only for automated tests.
# AUTH_SIGNIN_LIMIT_PER_MINUTE=5

# Optional: a firm whose confirmed services the public website lists (default: the standard service list).
# PUBLIC_ORGANIZATION_ID=
# Optional: set to false to pause new firm registrations (default open: the portal serves many firms).
# ALLOW_FIRM_REGISTRATION=false

# Outgoing email (SMTP, port 465 = TLS). Staff invitations and approval notices.
SMTP_HOST="smtp.example.com"
SMTP_PORT="465"
SMTP_USER="replace-me"
SMTP_PASS="replace-me"
MAIL_FROM="Firm name <noreply@example.com>"

# n8n webhooks for the admin dashboard's AI Summary and Chat buttons. Keep the
# real URLs out of git: anyone holding them can trigger the workflows.
N8N_SUMMARY_WEBHOOK_URL="https://example.app.n8n.cloud/webhook/replace-me"
N8N_CHAT_WEBHOOK_URL="https://example.app.n8n.cloud/webhook/replace-me/chat"

# AI assistant (/app/assistant) — DeepSeek, OpenAI-compatible API.
DEEPSEEK_API_KEY="sk-replace-me"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-v4-pro"
# "disabled" = fastest answers; "enabled" = the model thinks first (slower, deeper).
DEEPSEEK_THINKING="disabled"
DEEPSEEK_REASONING_EFFORT="high"
AI_MAX_TOOL_ROUNDS="8"
AI_MAX_OUTPUT_TOKENS="4000"
# Live Google Sheet read on demand (must be shared as "anyone with the link can view").
AI_SHEET_URL="https://docs.google.com/spreadsheets/d/<sheet-id>/edit?usp=sharing"
# Organization ids (comma separated) that may read the sheet. Empty = no firm.
AI_SHEET_ORGANIZATION_IDS=""
AI_SHEET_FRESH_SECONDS="60"
# Upstash Redis REST (optional): shared sheet cache + assistant rate limits. Without it, an in-memory cache is used.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
