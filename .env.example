# Copy to .env.local and fill in real values. Never commit real credentials.

# Neon pooled connection string (host contains "-pooler") — used by the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require"
# Neon direct connection string (same host WITHOUT "-pooler") — used by Prisma CLI for migrations
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Better Auth — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET="replace-with-32-byte-random-base64"
BETTER_AUTH_URL="http://localhost:3000"

# AES-256-GCM key, base64-encoded 32 bytes (same command as above). Losing it makes encrypted fields unreadable.
DATA_ENCRYPTION_KEY="replace-with-32-byte-random-base64"

# AWS S3 private document storage
AWS_ACCESS_KEY_ID="replace-me"
AWS_SECRET_ACCESS_KEY="replace-me"
AWS_REGION="ap-south-1"
AWS_BUCKET_NAME="replace-me"
S3_KEY_PREFIX="ss-dimri"

# Optional: per-IP sign-in attempts per minute (default 5). Raise only for automated tests.
# AUTH_SIGNIN_LIMIT_PER_MINUTE=5

# Optional: the firm that public client registrations belong to (defaults to the only organization).
# PUBLIC_ORGANIZATION_ID=
# Optional: keep the owner/firm registration page open after the first firm is set up (default closed).
# ALLOW_FIRM_REGISTRATION=false

# Outgoing email (SMTP, port 465 = TLS). Staff invitations and approval notices.
SMTP_HOST="smtp.example.com"
SMTP_PORT="465"
SMTP_USER="replace-me"
SMTP_PASS="replace-me"
MAIL_FROM="Firm name <noreply@example.com>"
